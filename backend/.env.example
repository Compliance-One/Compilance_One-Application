# ── Server ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://gst_user:gst_pass@localhost:5432/gst_voicebilling

# ── Auth ─────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ──────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Cloud STT (optional — only needed for cloud fallback) ─
GOOGLE_SPEECH_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
